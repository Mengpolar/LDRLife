<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全配置：
    1. 本地开发/调试地址允许明文（127.0.0.1/localhost/10.0.2.2）
    2. 生产中继 relay.p01arbear.top 走 TLS；信任服务器自签证书（锁定式信任，
       比 CA 公信更抗 MITM；未来换成 Let's Encrypt 后，系统默认信任同样
       通过——但该域名的 trust-anchors 仅含锁定证书，届时需将 LE 证书链
       一并加入此 trust-anchors 或移除该 domain-config）
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <domain-config>
        <domain includeSubdomains="false">relay.p01arbear.top</domain>
        <trust-anchors>
            <certificates src="@raw/relay_cert" />
        </trust-anchors>
    </domain-config>
</network-security-config>
