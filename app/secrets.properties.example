# LDRLife 构建密钥模板 —— 复制为 secrets.properties 后填入真实值
# 真实的 secrets.properties 不入库（见 .gitignore）；CI 构建用 GitHub Secrets 注入。
#
# ldr.serverUrl : 服务器地址（生产 https://host:port；本地联调 http://127.0.0.1:9443）
# ldr.gate      : 部署级门禁密钥（与服务器 config.toml 的 gate 一致，>=16 位随机串）
# ldr.encKey    : 64 位 hex（32 字节），用于加密打包上述两项；生成：openssl rand -hex 32

ldr.serverUrl=
ldr.gate=
ldr.encKey=

# ldr.amapKey : 高德开放平台 Android Key（M2 地图瓦片用；绑定包名 com.mengpolar.ldrlife + 签名 SHA1）
ldr.amapKey=

# 签名密钥库（固定 SHA1 -> 高德 Key 绑定；CI 从 LDRLIFE_KEYSTORE_B64 解码）
ldr.keystoreFile=ldrlife-ci.keystore
ldr.keystorePass=
ldr.keystoreAlias=ldrlife
